# Copy to .env and adjust. Values shown are the prototype defaults.

# --- Mode ---
# SHADOW: predictions are computed and logged but never surfaced as alerts.
# LIVE: predictions that clear the promotion gate are surfaced as alerts.
SHADOWLINE_MODE=SHADOW

# --- Line configuration ---
SHADOWLINE_LINE_CONFIG=configs/lines/plant2_line_a.yaml
SHADOWLINE_VARIANTS_CONFIG=configs/variants.yaml
SHADOWLINE_THRESHOLDS_CONFIG=configs/thresholds.yaml

# --- API ---
SHADOWLINE_API_HOST=0.0.0.0
SHADOWLINE_API_PORT=8000
SHADOWLINE_CORS_ORIGINS=http://localhost:5173

# --- Persistence ---
SHADOWLINE_DB_URL=sqlite:///./data/shadowline.db

# --- Twin / prediction cycle ---
SHADOWLINE_FORK_INTERVAL_SECONDS=60
SHADOWLINE_FORECAST_HORIZON_HOURS=4
SHADOWLINE_MONTE_CARLO_RUNS=200

# --- Decision layer ---
SHADOWLINE_ALARM_BUDGET_PER_OPERATOR_PER_HOUR=6

# --- sim_plant service ---
SIM_PLANT_LINE_CONFIG=configs/lines/plant2_line_a.yaml
SIM_PLANT_FAULTS_CONFIG=configs/faults.yaml
SIM_PLANT_SPEED_FACTOR=1.0
SIM_PLANT_TRANSPORT=http
SIM_PLANT_EMIT_HOST=0.0.0.0
SIM_PLANT_EMIT_PORT=8100

# --- Telemetry ---
SHADOWLINE_LOG_LEVEL=INFO
